{
    "name": "mitantsoa1/metrics-dash-laravel",
    "description": "SDK Laravel pour MetricsDash Enterprise avec interface d'administration embarquée de mappage dynamique BDD (/metrics-dash)",

    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "MetricsDash Team",
            "email": "dev@metricsdash.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "MetricsDash\\Laravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MetricsDash\\Laravel\\MetricsDashServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
